# Copy this file to .env and fill in your own values.
# .env itself is gitignored and should never be committed.

# Comma-separated list of API keys allowed to call this gateway.
# Leave blank and the gateway will auto-generate one on first run
# and save it here for you.
# Add multiple keys to enable rotation (see README "Key rotation" section):
# GATEWAY_API_KEYS=key-one,key-two,key-three
GATEWAY_API_KEYS=5420bd111b6841418f422a51c0da572c.TQ8_BtIFd4f2RR4Behi_8X-5, 3b56bc13a6eb406795ab6d0a0213e9ea.GDuaDgzevOl1s_6meC0TPvo5, 39f719c595594361a662bb61eb43dfea.Ir-UF7wfWYnTJ8pTRR8ARkck
# Where your Ollama server is running. Default is fine for local use.
OLLAMA_BASE_URL=http://localhost:11434

# Max requests per key per rolling 60-second window. Set to 0 to disable
# rate limiting entirely (all keys get unlimited requests).
RATE_LIMIT_PER_MINUTE=3    #For a fast test, temporarily lower the limit 3 to 5.

#(swap in your real key). It'll return something like:
#{ "limit_per_minute": 60, "used_in_window": 0, "remaining": 60 }
#Invoke-RestMethod -Uri "http://localhost:8000/v1/usage" -Method Get -Headers @{"Authorization"="Bearer YOUR_KEY"}

#If limit_per_minute shows 60 (or anything other than 3), that confirms the running server never actually picked up your .env change — meaning it's still using the old value from before it was first started, and my earlier "just restart it" instruction either didn't happen or didn't take effect.
