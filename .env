# Ollama Cloud API Gateway Configuration
# Copy this file to .env and fill in your actual API keys.

# Server settings
#HOST=0.0.0.0
#PORT=8000

# Ollama Cloud API Keys (comma-separated, supports unlimited accounts)
# Get your API keys from: https://ollama.com/settings
#OLLAMA_API_KEYS=5420bd111b6841418f422a51c0da572c.TQ8_BtIFd4f2RR4Behi_8X-5,3b56bc13a6eb406795ab6d0a0213e9ea.GDuaDgzevOl1s_6meC0TPvo5,39f719c595594361a662bb61eb43dfea.Ir-UF7wfWYnTJ8pTRR8ARkck


#GATEWAY_API_KEYS='JGEX6QGDlHhyflqnHKyqbYmlJ5QjQMdq8n4qd5gLCsU'



# Copy this file to .env and fill in your own values.
# .env itself is gitignored and should never be committed.

# Comma-separated list of API keys allowed to call this gateway.
# Leave blank and the gateway will auto-generate one on first run
# and save it here for you.
GATEWAY_API_KEYS=AOsXIX-pzcHUyOnP8lRXl9qiIKIw1vlwTtsEgrrGJ9A

# Where your Ollama server is running. Default is fine for local use.
OLLAMA_BASE_URL=http://localhost:11434
