# Copy this file to .env and fill in your own values.
# .env itself is gitignored and should never be committed.

# Comma-separated list of API keys allowed to call this gateway.
# Leave blank and the gateway will auto-generate one on first run
# and save it here for you.
# Add multiple keys to enable rotation (see README "Key rotation" section):
# GATEWAY_API_KEYS=key-one,key-two,key-three
GATEWAY_API_KEYS=

# Where your Ollama server is running. Default is fine for local use.
OLLAMA_BASE_URL=http://localhost:11434

# Max requests per key per rolling 60-second window. Set to 0 to disable
# rate limiting entirely (all keys get unlimited requests).
RATE_LIMIT_PER_MINUTE=60
