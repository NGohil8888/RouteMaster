# Copy this file to .env and fill in your own values.
# .env itself is gitignored and should never be committed.

# Comma-separated list of API keys allowed to call this gateway.
# Leave blank and the gateway will auto-generate one on first run
# and save it here for you.
# Add multiple keys to enable rotation (see README "Key rotation" section):
# GATEWAY_API_KEYS=key-one,key-two,key-three
GATEWAY_API_KEYS=

# Comma-separated Ollama Cloud API keys. The gateway sends these upstream and
# rotates to the next key when Ollama returns HTTP 429.
# Leave blank when using a local, unauthenticated Ollama server.
OLLAMA_API_KEYS=

# Where your Ollama server is running. Use the Ollama Cloud endpoint when
# using OLLAMA_API_KEYS; the local default needs no API key.
OLLAMA_BASE_URL=http://localhost:11434
