# Ollama Cloud API Gateway Configuration
# Copy this file to .env and fill in your actual API keys

# Server settings
HOST=0.0.0.0
PORT=8000

# Ollama Cloud API Keys (comma-separated, no spaces)
# Get your API keys from https://ollama.com/settings/keys
OLLAMA_API_KEYS=your_ollama_api_key_1,your_ollama_api_key_2

# Ollama Cloud base URL (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=https://ollama.com

# Gateway settings
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=120
HEALTH_CHECK_INTERVAL_SECONDS=30
ACCOUNT_COOLDOWN_SECONDS=60

# Logging
LOG_LEVEL=INFO