# Hermes Ollama Gateway - Environment Variables Template

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./data/hermes.db
# For PostgreSQL: postgresql://user:password@localhost/hermes

# API Configuration
APP_NAME=Hermes Ollama Gateway
APP_VERSION=1.0.0
DEBUG=false

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]

# Health Monitoring
HEALTH_CHECK_INTERVAL_SECONDS=15
HEALTH_CHECK_TIMEOUT_SECONDS=10
HEALTH_CHECK_FAILURES_THRESHOLD=3

# Request Configuration
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=3

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true
MAX_REQUEST_LOG_RETENTION_DAYS=30

# Features
ENABLE_METRICS=true