# Ollama Cloud API Gateway Configuration
# Copy this file to .env and fill in your actual API keys.

# Server settings
HOST=0.0.0.0
PORT=8000

# Ollama Cloud API Keys (comma-separated, supports unlimited accounts)
# Get your API keys from: https://ollama.com/settings
OLLAMA_API_KEYS=your_ollama_api_key_1_here,your_ollama_api_key_2_here,your_ollama_api_key_3_here

# Ollama Cloud base URL (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=https://ollama.com

# Retry and failover settings
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=120
ACCOUNT_COOLDOWN_SECONDS=60
HEALTH_CHECK_INTERVAL_SECONDS=30

# Logging
LOG_LEVEL=INFO

# Health check settings
HEALTH_CHECK_TIMEOUT_SECONDS=15
HEALTH_CHECK_MODEL=gemma3:4b

# Request settings
STREAM_TIMEOUT_SECONDS=300
MAX_CONCURRENT_REQUESTS_PER_ACCOUNT=10